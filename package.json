    "react-dom": "^19.1.0",
    "viem": "^2.38.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  }
